{
  "name": "MossOS",
  "short_name": "MossOS",
  "description": "Tasks, habits, focus and tools in one place.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#191918",
  "theme_color": "#121211",
  "categories": ["productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tasks", "url": "./?view=tasks", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Habits", "url": "./?view=habits", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Focus", "url": "./?view=focus", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
